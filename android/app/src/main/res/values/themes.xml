<resources>
    <style name="Theme.Rutitas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/rutitas_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash del sistema en blanco; enseguida se reproduce el GIF animado de Rutitas -->
    <style name="Theme.Rutitas.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFEFE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Rutitas</item>
    </style>
</resources>
